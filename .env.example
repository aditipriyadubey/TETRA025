# ============================================================
# EduBridge AI — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in real values.
#
#   cp .env.example .env.local
#
# .env.local is gitignored (covered by *.local in .gitignore).
# NEVER commit real keys to version control.
# ============================================================

# ── Supabase (client-side — exposed to the browser) ──────────
# These VITE_ prefixed variables are embedded in the client bundle.
# Use only the anon key here — never the service role key.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Supabase (server-side only — Edge Functions) ─────────────
# The service role key bypasses RLS.  It must NEVER appear in
# client-side code or VITE_ variables.

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── AI / LLM (server-side only — Edge Functions) ─────────────
# These will be used by the AI engineer's Edge Function logic.
# Uncomment and fill in when the AI integration phase begins.

# GROQ_API_KEY=your-groq-api-key-here
# GEMINI_API_KEY=your-gemini-api-key-here
